# --- MongoDB Atlas credentials ---
# NOTE: the previously hardcoded password was leaked in git history.
# Rotate it in Atlas before reusing this project.
DATABASE_USERNAME=your_db_user
DATABASE_PASSWORD=your_db_password

# Optional: full connection string. If set, it overrides the username/password above.
# DATABASE_URL=mongodb+srv://user:pass@cluster0.mpdyonk.mongodb.net/CMS

# JWT signing secret for API tokens.
JWT_SECRET=change_me_to_a_long_random_string

# HTTP port the server listens on.
PORT=3001
